---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isoDay, stamp } from '../../lib/date';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { id: note.id }, props: { note } }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const day = isoDay(note.data.date);
---

<BaseLayout
  title={note.data.title}
  description={note.data.description}
  ogType="article"
  publishedTime={note.data.date.toISOString()}
>
  <article>
    <header class="article__head">
      <p class="article__eyebrow">Note</p>
      <h1 class="article__title">{note.data.title}</h1>
      <p class="article__meta">
        <time datetime={day}>{stamp(day)}</time>
        {note.data.tags.map((tag) => <span>{tag}</span>)}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="crumbs">
    <a href="/notes">ALL NOTES</a>
    <a href="/archive/zh">ARCHIVE</a>
  </p>
</BaseLayout>
