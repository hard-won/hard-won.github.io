---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Résumé"
  description="Résumé available on request by email. See the About and Projects pages for background and current work."
>
  <header class="page-head">
    <h1 class="page-head__title">Résumé</h1>
    <p class="page-head__kicker">ON REQUEST · PDF</p>
  </header>

  <p class="band">
    My résumé is available on request. Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> and I
    will send the current version as a PDF.
  </p>

  <section aria-labelledby="meanwhile">
    <h2 class="index-head index-head--stacked" id="meanwhile">
      <span>IN THE MEANTIME</span>
      <span>3 LINKS</span>
    </h2>

    <dl class="spec">
      <dt>About</dt>
      <dd><a href="/about">Background and what I work on</a></dd>
      <dt>Projects</dt>
      <dd><a href="/projects">Current work and its real status</a></dd>
      <dt>Code</dt>
      <dd><a href={SITE.github}>{SITE.github.replace(/^https?:\/\//, '')}</a></dd>
    </dl>
  </section>
</BaseLayout>
