---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { stamp } from '../../../lib/date';

export async function getStaticPaths() {
  const posts = await getCollection('archive');
  // Paths come from the frontmatter slug, not the loader-generated id, so the
  // original Hexo permalink segment is preserved exactly (case included).
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'archive'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const year = post.data.displayDate.slice(0, 4);
const formattedDate = stamp(post.data.displayDate);

const description =
  `${post.data.title} — archived Chinese-language post from ${year}` +
  (post.data.categories.length ? ` (${post.data.categories.join(' / ')})` : '') +
  '.';
---

{/* The page is zh-CN because the post body is. Every interface string on it is
    English and marked lang="en"; the post's own categories and tags are the
    author's original metadata, so they stay Chinese and stay zh-CN. */}
<BaseLayout
  title={post.data.title}
  description={description}
  lang="zh-CN"
  ogType="article"
  publishedTime={post.data.date.toISOString()}
>
  <article>
    <header class="article__head">
      <p class="article__eyebrow" lang="en">Archive</p>
      <h1 class="article__title" lang="zh-CN">{post.data.title}</h1>
      <p class="article__meta" lang="en">
        <time datetime={post.data.displayDate}>{formattedDate}</time>
        {post.data.categories.length > 0 && <span lang="zh-CN">{post.data.categories.join(' / ')}</span>}
        {post.data.tags.map((tag) => <span lang="zh-CN">{tag}</span>)}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>

  <p class="crumbs" lang="en">
    <a href="/archive/zh">ARCHIVE INDEX</a>
    <a href="/notes">NOTES</a>
  </p>
</BaseLayout>
