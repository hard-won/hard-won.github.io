---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('archive');
  // Paths come from the frontmatter slug, not the loader-generated id, so the
  // original Hexo permalink segment is preserved exactly (case included).
  return posts.map((post) => ({ params: { slug: post.data.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'archive'>;
}

const { post } = Astro.props;
const { Content } = await render(post);

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

/** Format the stored calendar date directly; no timezone conversion. */
const [year, month, day] = post.data.displayDate.split('-');
const formattedDate = `${day} ${MONTHS[Number(month) - 1]} ${year}`;

const description =
  `${post.data.title} — archived Chinese-language post from ${year}` +
  (post.data.categories.length ? ` (${post.data.categories.join(' / ')})` : '') +
  '.';
---

<BaseLayout
  title={post.data.title}
  description={description}
  lang="zh-CN"
  ogType="article"
  publishedTime={post.data.date.toISOString()}
>
  <article>
    <header class="post-header">
      <p class="eyebrow">Archive · 中文</p>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.displayDate}>{formattedDate}</time>
        {post.data.categories.length > 0 && <> · {post.data.categories.join(' / ')}</>}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="tag-row">
            {post.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose archive-body">
      <Content />
    </div>
  </article>

  <p style="margin-top:2.5rem" lang="en">
    <a href="/archive/zh">← Archive index</a>
  </p>
</BaseLayout>
