---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const posts = (await getCollection('archive')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  // Group by the date the post originally carried, not the UTC instant.
  const year = Number(post.data.displayDate.slice(0, 4));
  const bucket = byYear.get(year);
  if (bucket) bucket.push(post);
  else byYear.set(year, [post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];

/** Format the stored calendar date directly; no timezone conversion. */
function formatDay(displayDate: string): string {
  const [, month, day] = displayDate.split('-');
  return `${day} ${MONTHS[Number(month) - 1]}`;
}
---

<BaseLayout
  title="Archive"
  description="Sixteen older Chinese-language posts on PCIe, ASIC synthesis, RTL coding style and GPU microarchitecture, preserved from the previous version of this site."
>
  <h1>Archive</h1>

  <p class="lede">Earlier notes, written in Chinese. {posts.length} entries.</p>

  {
    years.map(([year, items]) => (
      <section class="year-group">
        <h2>{year}</h2>
        <ul class="entry-list">
          {items.map((post) => (
            <li>
              <time datetime={post.data.displayDate}>{formatDay(post.data.displayDate)}</time>
              <span class="entry-title">
                <a href={`/archive/zh/${post.data.slug}/`} lang="zh-CN">
                  {post.data.title}
                </a>
              </span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
