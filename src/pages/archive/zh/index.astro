---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { entryCount, stampDay } from '../../../lib/date';

const posts = (await getCollection('archive')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  // Group by the date the post originally carried, not the UTC instant.
  const year = Number(post.data.displayDate.slice(0, 4));
  const bucket = byYear.get(year);
  if (bucket) bucket.push(post);
  else byYear.set(year, [post]);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout
  title="Archive"
  description="Sixteen older Chinese-language posts on PCIe, ASIC synthesis, RTL coding style and GPU microarchitecture, preserved from the previous version of this site."
>
  <header class="page-head">
    <h1 class="page-head__title">Archive</h1>
    <p class="page-head__kicker">PCIe · ASIC SYNTHESIS · RTL STYLE · GPU</p>
    <p class="page-head__lede">
      Earlier notes, written in Chinese and preserved from the previous version of this site. Every
      old permalink still resolves here.
    </p>
  </header>

  {
    years.map(([year, items], i) => (
      <section aria-labelledby={`y${year}`}>
        <h2 class:list={['index-head', i > 0 && 'index-head--stacked']} id={`y${year}`}>
          <span>{year}</span>
          <span>{entryCount(items.length)}</span>
        </h2>

        <ol class="index">
          {items.map((post) => (
            <li>
              <a class="index__row" href={`/archive/zh/${post.data.slug}/`}>
                <span class="index__tick" aria-hidden="true">
                  +
                </span>
                <time class="index__date" datetime={post.data.displayDate}>
                  {stampDay(post.data.displayDate)}
                </time>
                <span class="index__title" lang="zh-CN">
                  {post.data.title}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

  <p class="crumbs">
    <a href="/notes">NOTES</a>
    <a href="/">HOME</a>
  </p>
</BaseLayout>
