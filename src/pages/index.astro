---
import BaseLayout from '../layouts/BaseLayout.astro';
import Pipeline from '../components/Pipeline.astro';
import { SITE, FRAMING } from '../data/site';
import { projects } from '../data/projects';

const shipped = projects.filter((p) => p.status !== 'in design');
const planned = projects.filter((p) => p.status === 'in design');
---

<BaseLayout
  title={SITE.name}
  description="Shengyi Wei — digital design and computer architecture, focused on AI data movement, memory systems, interconnects and RTL."
>
  <section>
    <h1>{SITE.name}</h1>
    <p class="lede">
      Digital Design / Computer Architecture — AI data movement, memory systems, interconnects and
      NoC, workload-driven performance modeling, simulation, and RTL.
    </p>
    <p class="prose" style="margin-top:1.25rem">{FRAMING}</p>
    <Pipeline />
  </section>

  <section class="section">
    <h2>Selected work</h2>
    {
      shipped.length === 0 ? (
        <div class="note-box">
          <p>
            Nothing is listed here yet. This portfolio is being rebuilt around a small number of
            substantial projects rather than a long list of small ones, and no entry goes up until
            it is real and finished enough to be read critically.
          </p>
          <p>
            The directions currently in design are below, and <a href="/projects">/projects</a>{' '}
            has the detail.
          </p>
        </div>
      ) : (
        <ul class="card-list">
          {shipped.map((p) => (
            <li class="card">
              <h3>
                {p.title}
                <span class="status">{p.status}</span>
              </h3>
              <p>{p.summary}</p>
            </li>
          ))}
        </ul>
      )
    }
    {
      planned.length > 0 && (
        <ul class="entry-list" style="margin-top:1.25rem">
          {planned.map((p) => (
            <li>
              <span class="entry-title">{p.title}</span>
              <span class="status">{p.status}</span>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="section">
    <h2>Current direction</h2>
    <div class="prose">
      <p>
        The work I care about starts at the workload. A model's execution is, from the hardware's
        point of view, a pattern of reads and writes — and most of what limits an accelerator is
        decided by that pattern long before it reaches a datapath.
      </p>
      <p>
        So the direction is to measure that pattern honestly, model what it costs in a memory
        system and across an interconnect, and then build the piece of RTL the model argues for.
        Each step should be checkable against the one before it.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Writing</h2>
    <div class="prose">
      <p>
        <a href="/notes">Notes</a> — English technical notes, written as the work above produces
        something worth writing down.
      </p>
      <p>
        <a href="/archive/zh">Archive (中文)</a> — sixteen older Chinese posts on PCIe, ASIC
        synthesis, RTL style and GPU microarchitecture, preserved from the previous version of this
        site.
      </p>
    </div>
  </section>

  <section class="section">
    <h2>Contact</h2>
    <dl class="contact-grid">
      <dt>Email</dt>
      <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      <dt>GitHub</dt>
      <dd><a href={SITE.github}>github.com/hard-won</a></dd>
      {
        SITE.links.map((link) => (
          <>
            <dt>{link.label}</dt>
            <dd>
              <a href={link.href}>{link.href.replace(/^https?:\/\//, '')}</a>
            </dd>
          </>
        ))
      }
    </dl>
  </section>
</BaseLayout>
