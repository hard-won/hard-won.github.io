---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DataflowFigure from '../components/DataflowFigure.astro';
import { SITE, FRAMING } from '../data/site';
import { isFeatured, titleLang } from '../lib/reading';

// The front page lists the technical reading notes. `notebook` entries are
// personal reading: they keep their place under /reading and stay off here.
const posts = (await getCollection('reading', ({ data }) => isFeatured(data.category))).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const MONTHS = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

/**
 * Format the stored calendar date directly, with no timezone conversion:
 * `displayDate` is the date the post originally carried, and `date` is the
 * precise instant, which shifts a day under UTC.
 */
function stamp(displayDate: string): string {
  const [year, month, day] = displayDate.split('-');
  return `${day} ${MONTHS[Number(month) - 1]} ${year}`;
}
---

<BaseLayout
  title={SITE.name}
  description="Shengyi Wei — digital design and computer architecture, focused on AI data movement, memory systems, interconnects and RTL."
>
  <section class="masthead">
    <h1 class="masthead__name">{SITE.name}</h1>
    <p class="masthead__kicker">AI DATA MOVEMENT · MEMORY SYSTEMS · INTERCONNECT · RTL</p>
  </section>

  <p class="framing">{FRAMING}</p>

  <DataflowFigure />

  <p class="note-link">
    <a href="/notes/decode-step-as-traffic/">READ THE NOTE → A DECODE STEP, AS TRAFFIC</a>
  </p>

  <blockquote class="pullquote">
    <p>Life is a long trade, not a greedy algorithm.</p>
  </blockquote>

  <section aria-labelledby="writing">
    <h2 class="index-head" id="writing">
      <span>READING NOTES</span>
      <span>{posts.length} ENTRIES</span>
    </h2>

    <ol class="index">
      {
        posts.map((post) => (
          <li>
            <a class="index__row" href={`/reading/${post.data.slug}/`}>
              <span class="index__tick" aria-hidden="true">
                +
              </span>
              <time class="index__date" datetime={post.data.displayDate}>
                {stamp(post.data.displayDate)}
              </time>
              <span class="index__title" lang={titleLang(post.data.title)}>
                {post.data.title}
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="index__foot">
      <a href="/reading">ALL READING</a>
      <a href="/notes">NOTES</a>
    </p>
  </section>
</BaseLayout>

<style>
  /* Sits directly under the figure caption, in the caption's own idiom, and
     needs no JavaScript to be there. */
  .note-link {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    margin: 0 0 4rem;
  }
</style>
