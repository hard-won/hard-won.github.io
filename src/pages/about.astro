---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, FRAMING } from '../data/site';
---

<BaseLayout
  title="About"
  description="Shengyi Wei is a digital design and computer architecture engineer working on AI data movement, memory systems, interconnects and RTL."
>
  <header class="page-head">
    <h1 class="page-head__title">About</h1>
    <p class="page-head__kicker">AI DATA MOVEMENT · MEMORY SYSTEMS · INTERCONNECT · RTL</p>
  </header>

  <div class="prose">
    <p>
      I am <strong>{SITE.name}</strong>, a digital design and computer architecture engineer. My
      work sits around AI data movement: memory systems, interconnects and network-on-chip,
      workload-driven performance modeling, simulation, and RTL.
    </p>
    <p>{FRAMING}</p>
    <p>
      That means starting from what a model actually does to memory rather than from a block
      diagram, and carrying the measurement forward into the memory system, the interconnect, and
      then the hardware it justifies.
    </p>
    <p>
      <a href="/projects">Projects</a> is what I am building. <a href="/notes">Notes</a> is English
      write-ups. <a href="/reading">Reading</a> is notes worked through from other people's
      material — a blog series, a specification, a repository — on PCIe, ASIC synthesis, RTL coding
      style and GPU microarchitecture, with the source named on every entry. Those bodies are still
      Chinese, and are being rewritten.
    </p>
  </div>

  <section aria-labelledby="contact">
    <h2 class="index-head index-head--stacked" id="contact">
      <span>CONTACT</span>
      <span>{SITE.links.length + 2} LINKS</span>
    </h2>

    <dl class="spec">
      <dt>Email</dt>
      <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      <dt>GitHub</dt>
      <dd><a href={SITE.github}>{SITE.github.replace(/^https?:\/\//, '')}</a></dd>
      {
        SITE.links.map((link) => (
          <>
            <dt>{link.label}</dt>
            <dd>
              <a href={link.href}>{link.href.replace(/^https?:\/\//, '')}</a>
            </dd>
          </>
        ))
      }
    </dl>
  </section>
</BaseLayout>
