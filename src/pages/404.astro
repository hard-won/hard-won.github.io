---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist on this site.">
  <h1>404 — page not found</h1>
  <p class="lede">That URL does not exist here.</p>

  <div class="prose" style="margin-top:1.5rem">
    <p>
      If you followed a link to an older post, try the <a href="/archive/zh">Chinese archive</a> —
      every permalink from the previous version of this site redirects there.
    </p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/projects">Projects</a></li>
      <li><a href="/notes">Notes</a></li>
      <li><a href="/about">About</a></li>
    </ul>
  </div>
</BaseLayout>
