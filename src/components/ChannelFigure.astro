---
/**
 * FIG. 01 — LINK.
 *
 * A channel: transmitter, a buffer in the middle, receiver, and flits moving
 * left to right along it. Two cadences (a clean pass, and one that stalls in
 * the buffer before release) plus negative animation delays give an uneven,
 * ambient rhythm that is never empty on first paint.
 *
 * Pure SVG + CSS. No dependencies, no client JavaScript. Under
 * prefers-reduced-motion every flit is still drawn, parked at its own --x,
 * with two sitting in the buffer. Styles live in global.css under "Homepage".
 *
 * Geometry: the channel runs x=78 -> x=642 at y=60, so a flit's travel is
 * translateX(0) -> translateX(556px). A --hold of 258/276 parks it inside the
 * buffer node (x=330..390).
 */

/** kind: 'pass' travels straight through; 'queued' stalls at --hold first. */
type Flit = {
  kind: 'pass' | 'queued';
  /** Negative, so the channel starts mid-flight. */
  delay: string;
  /** Resting position when motion is reduced. */
  x: number;
  /** Where a queued flit waits. */
  hold?: number;
  /** Dropped below 30rem to keep the drawing readable when it scales down. */
  thin?: boolean;
};

const flits: Flit[] = [
  { kind: 'pass', delay: '-1s', x: 60 },
  { kind: 'queued', delay: '-3s', x: 258, hold: 258 },
  { kind: 'pass', delay: '-5.5s', x: 160, thin: true },
  { kind: 'queued', delay: '-10s', x: 276, hold: 276, thin: true },
  { kind: 'pass', delay: '-8.5s', x: 430 },
];

/** Channel graduations, skipping the buffer node. */
const ticks = [120, 160, 200, 240, 280, 440, 480, 520, 560, 600];
---

<figure class="fig">
  <div class="fig__frame">
    <svg
      viewBox="0 0 720 120"
      role="img"
      aria-label="A link: flits move from a transmitter, through a buffer where some of them wait, to a receiver."
    >
      <!-- endpoints and buffer -->
      <rect class="fig-wire" x="20" y="38" width="58" height="44"></rect>
      <rect class="fig-wire" x="330" y="34" width="60" height="52"></rect>
      <rect class="fig-wire" x="642" y="38" width="58" height="44"></rect>

      <!-- the channel -->
      <line class="fig-wire" x1="78" y1="60" x2="642" y2="60"></line>
      {ticks.map((x) => <line class="fig-tick" x1={x} y1="62" x2={x} y2="69" />)}

      <text class="fig-label" x="20" y="26">TX</text>
      <text class="fig-label" x="330" y="26">BUF</text>
      <text class="fig-label" x="700" y="26" text-anchor="end">RX</text>

      {
        flits.map((f) => (
          <g
            class:list={[
              'fig-flit',
              f.kind === 'queued' && 'fig-flit--queued',
              f.thin && 'fig-flit--thin',
            ]}
            style={`animation-delay:${f.delay};--x:${f.x}px;${
              f.hold === undefined ? '' : `--hold:${f.hold}px;`
            }`}
          >
            <rect x="78" y="56" width="14" height="8" />
          </g>
        ))
      }
    </svg>
  </div>
  <figcaption class="fig__caption">FIG. 01 — LINK</figcaption>
</figure>
