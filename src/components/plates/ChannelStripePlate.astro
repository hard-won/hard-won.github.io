---
/**
 * FIG. 02 — WHERE THE BYTES ARE PLACED.
 *
 * A physical mapping example, not a channel sweep over time. One stated
 * policy — chunk G = 256 B, channel(a) = floor(a/G) mod 16 — applied to two
 * assumed physical ranges, with the channel each chunk lands on printed
 * under it. Every digit on this plate is computed by channelForAddress()
 * from src/lib/decode-traffic/, the same function tests/reference.test.ts
 * checks, so the plate cannot drift from the policy it prints.
 *
 * Two things the drawing states in its own footer, because they are the two
 * ways a reader would otherwise misread it: address order is not the order
 * a channel serves requests, and a full cycle is sixteen channels, so the
 * seventeenth chunk returns to CH0 and no earlier.
 *
 * The lower band is HBM3's channel structure, drawn separately from the
 * mapping: four of the sixteen channels, said so on the plate.
 *
 * Static SVG, two drawings swapped by one media query. Mobile wraps the same
 * seventeen chunks into rows; it does not shrink the channel count.
 */
import { channelForAddress } from '../../lib/decode-traffic/index.ts';

/** The illustration chunk. Not a JEDEC burst, not a device line size. */
const G = 256;
const CHANNELS = 16;

/** Chunk base addresses, as multiples of G. Two assumed physical ranges. */
const WEIGHT_BASE = 0;
const KV_BASE = 37;

interface Chunk {
  /** Offset label, in units of G. */
  label: string;
  ch: number;
  /** True where the channel cycle wraps back to 0. */
  wrap: boolean;
}

function range(baseChunks: number, count: number): Chunk[] {
  return Array.from({ length: count }, (_, i) => {
    const address = (baseChunks + i) * G;
    const ch = channelForAddress(address, G, CHANNELS);
    return { label: `${baseChunks + i}G`, ch, wrap: i > 0 && ch === 0 };
  });
}

/** A full cycle plus the wrap: 0G..16G maps to 0..15, then 0 again. */
const WEIGHTS = range(WEIGHT_BASE, CHANNELS + 1);
const KV = range(KV_BASE, 8);

const POLICY = `CHANNEL(A) = FLOOR(A / ${G}B) MOD ${CHANNELS}`;

interface Spec {
  id: 'wide' | 'narrow';
  w: number;
  h: number;
  /** Chunks per drawn row; the rest wrap onto the next row. */
  perRow: number;
  cell: { w: number; pitch: number; h: number };
  rowPitch: number;
  /** Band anchors. */
  policyY: number;
  aY: number;
  bY: number;
  cY: number;
  /** Representative channel boxes drawn from the sixteen. */
  shown: number;
  box: { w: number; pitch: number; h: number };
  pc: { w: number; x0: number; x1: number; y: number; h: number };
  policy: string;
  head: { a: string; b: string; c: string };
  foot: string[];
}

const wide: Spec = {
  id: 'wide',
  w: 560,
  h: 312,
  perRow: 17,
  cell: { w: 29, pitch: 32.5, h: 17 },
  rowPitch: 34,
  policyY: 12,
  aY: 33,
  bY: 102,
  cY: 171,
  shown: 4,
  box: { w: 108, pitch: 116, h: 52 },
  pc: { w: 44, x0: 6, x1: 58, y: 20, h: 22 },
  policy: `CHANNEL(A) = FLOOR(A / ${G}B) MOD ${CHANNELS} · G = ${G} B`,
  head: {
    a: 'MATRIX WEIGHTS · ASSUMED PHYSICAL RANGE FROM BASE 0G',
    b: 'KV TENSORS, ONE LAYER · ASSUMED PHYSICAL RANGE FROM BASE 37G',
    c: 'HBM3 STRUCTURE · 16 CHANNELS, 2 PSEUDO-CHANNELS EACH · 4 DRAWN',
  },
  foot: [
    'DIGIT = CHANNEL THE ADDRESS MAPS TO · ADDRESS ORDER, NOT SERVICE ORDER',
    'G IS AN ILLUSTRATION CHUNK, NOT A JEDEC BURST OR A DEVICE LINE SIZE',
    'BOTH BASES ARE ASSUMED · PHYSICAL LAYOUT IS IMPLEMENTATION-DEPENDENT',
    'PC0/PC1: 32-BIT DATA EACH, SHARED COMMAND BUS, COMMANDS EXECUTED SEPARATELY',
  ],
};

const narrow: Spec = {
  id: 'narrow',
  w: 300,
  h: 424,
  perRow: 6,
  cell: { w: 42, pitch: 48, h: 17 },
  rowPitch: 34,
  policyY: 12,
  aY: 33,
  bY: 160,
  cY: 260,
  shown: 2,
  box: { w: 132, pitch: 140, h: 52 },
  pc: { w: 54, x0: 8, x1: 70, y: 20, h: 22 },
  policy: `CH(A) = FLOOR(A/${G}B) MOD ${CHANNELS}`,
  head: {
    a: 'MATRIX W · BASE 0G',
    b: 'KV, ONE LAYER · BASE 37G',
    c: 'HBM3 · 16 CHANNELS, 2 OF 16 DRAWN',
  },
  foot: [
    'DIGIT = CHANNEL THE ADDRESS MAPS TO',
    'ADDRESS ORDER, NOT SERVICE ORDER',
    'G IS ILLUSTRATIVE, NOT A JEDEC BURST',
    'BASES ASSUMED · LAYOUT DEPENDS ON',
    'THE IMPLEMENTATION',
    'PC0/PC1: 32-BIT DATA, SHARED CMD BUS',
  ],
};

const CAPTION = `FIG. 02 — ONE ADDRESS-MAPPING POLICY, TWO ASSUMED RANGES · ${POLICY}, G = 256 B`;

const LABEL = `Physical address mapping example for HBM3. A stated policy, channel of address a equals floor of a divided by G, modulo 16, with G an illustrative 256-byte chunk that is not a JEDEC burst or a device line size. The top band is an assumed contiguous range of matrix weights from base 0G: its seventeen consecutive chunks, 0G to 16G, map to channels 0 through 15 and then back to 0, so a full cycle is sixteen channels and the wrap happens on the seventeenth chunk. The middle band is an assumed range holding one layer's KV tensors, based at 37G; the same function sends its chunks to channels 5, 6, 7 and onward. Both bases are assumed: physical layout is implementation-dependent, a head is a tensor dimension rather than a separate allocation, and either range could be contiguous, strided, blocked or paged. The digits are address order, not the order in which a channel serves requests; queues, scheduling and bank state decide that. The bottom band is HBM3's channel structure, drawn separately from the mapping: four of the sixteen channels, each split into two pseudo-channels with a 32-bit data bus each, sharing a command bus and executing commands separately.`;

const plates = [wide, narrow];

/** Chunk positions, wrapped into rows of s.perRow. */
function laid(s: Spec, chunks: Chunk[]) {
  return chunks.map((c, i) => ({
    ...c,
    x: (i % s.perRow) * s.cell.pitch,
    row: Math.floor(i / s.perRow),
  }));
}
---

<figure class="plate">
  <div class="plate__frame">
    {
      plates.map((s) => {
        const weights = laid(s, WEIGHTS);
        const kv = laid(s, KV);
        const footY = s.cY + 14 + s.box.h + 20;
        return (
          <svg
            class:list={['plate__svg', `plate__svg--${s.id}`]}
            viewBox={`0 0 ${s.w} ${s.h}`}
            role="img"
            aria-label={LABEL}
          >
            <title>{LABEL}</title>

            <g aria-hidden="true">
              {/* the policy, printed above the thing it produces */}
              <text class="hdr hdr--policy" x="0" y={s.policyY + 1}>
                {s.policy}
              </text>
              <line class="ln" x1="0" y1={s.policyY + 7} x2={s.w - 4} y2={s.policyY + 7} />

              {/* band A — an assumed contiguous weight range, one full cycle plus the wrap */}
              <text class="hdr" x="0" y={s.aY + 1}>
                {s.head.a}
              </text>
              <line class="ln" x1="0" y1={s.aY + 7} x2={s.w - 4} y2={s.aY + 7} />
              {weights.map((c) => {
                const y = s.aY + 15 + c.row * s.rowPitch;
                return (
                  <>
                    <rect
                      class:list={['cell', c.wrap && 'cell--on']}
                      x={c.x}
                      y={y}
                      width={s.cell.w}
                      height={s.cell.h}
                    />
                    <text class="addr" x={c.x + s.cell.w / 2} y={y + 12}>
                      {c.label}
                    </text>
                    <text class:list={['ch', c.wrap && 'ch--on']} x={c.x + s.cell.w / 2} y={y + 28}>
                      {c.ch}
                    </text>
                  </>
                );
              })}

              {/* band B — a second assumed range, the same function, different channels */}
              <text class="hdr" x="0" y={s.bY + 1}>
                {s.head.b}
              </text>
              <line class="ln" x1="0" y1={s.bY + 7} x2={s.w - 4} y2={s.bY + 7} />
              {kv.map((c) => {
                const y = s.bY + 15 + c.row * s.rowPitch;
                return (
                  <>
                    <rect class="cell" x={c.x} y={y} width={s.cell.w} height={s.cell.h} />
                    <text class="addr" x={c.x + s.cell.w / 2} y={y + 12}>
                      {c.label}
                    </text>
                    <text class="ch" x={c.x + s.cell.w / 2} y={y + 28}>
                      {c.ch}
                    </text>
                  </>
                );
              })}

              {/* band C — the channel structure itself, separate from the mapping */}
              <text class="hdr" x="0" y={s.cY + 1}>
                {s.head.c}
              </text>
              <line class="ln" x1="0" y1={s.cY + 7} x2={s.w - 4} y2={s.cY + 7} />
              {Array.from({ length: s.shown }, (_, i) => {
                const x = i * s.box.pitch;
                const y = s.cY + 14;
                return (
                  <>
                    <rect class="box" x={x} y={y} width={s.box.w} height={s.box.h} />
                    <text class="lbl" x={x + 8} y={y + 14}>
                      {`CH${i}`}
                    </text>
                    <rect class="pc" x={x + s.pc.x0} y={y + s.pc.y} width={s.pc.w} height={s.pc.h} />
                    <text class="lbl" x={x + s.pc.x0 + 7} y={y + s.pc.y + 15}>
                      PC0
                    </text>
                    <rect class="pc" x={x + s.pc.x1} y={y + s.pc.y} width={s.pc.w} height={s.pc.h} />
                    <text class="lbl" x={x + s.pc.x1 + 7} y={y + s.pc.y + 15}>
                      PC1
                    </text>
                  </>
                );
              })}
              <text class="hdr" x={s.shown * s.box.pitch + 6} y={s.cY + 14 + s.box.h / 2 + 4}>
                …
              </text>

              <line class="ln" x1="0" y1={footY - 12} x2={s.w - 4} y2={footY - 12} />
              {s.foot.map((t, i) => (
                <text class="hdr" x="0" y={footY + i * 14}>
                  {t}
                </text>
              ))}
            </g>
          </svg>
        );
      })
    }
  </div>
  <figcaption class="plate__caption">{CAPTION}</figcaption>
</figure>

<style>
  .plate {
    margin: 2.25rem 0 2.5rem;
  }

  .plate__frame {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.1rem 0;
  }

  .plate__caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    line-height: 1.6;
    color: var(--fg-faint);
    margin-top: 0.6rem;
  }

  .plate__svg {
    display: block;
    width: 100%;
    height: auto;
    --sz: 10px;
    --foot: 9.5px;
  }

  .plate__svg--narrow {
    display: none;
    max-width: 21rem;
    --sz: 11px;
    --foot: 10px;
  }

  @media (max-width: 40rem) {
    .plate__svg--wide {
      display: none;
    }

    .plate__svg--narrow {
      display: block;
    }
  }

  .ln {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .box,
  .cell,
  .pc {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .cell--on {
    fill: var(--accent);
    fill-opacity: 0.16;
    stroke: var(--accent);
  }

  .hdr,
  .addr,
  .ch,
  .lbl {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  .hdr {
    font-size: var(--foot);
    letter-spacing: 0.14em;
    fill: var(--fg-faint);
  }

  .hdr--policy {
    fill: var(--fg-muted);
  }

  .addr {
    font-size: calc(var(--sz) - 1px);
    fill: var(--fg-muted);
    text-anchor: middle;
    letter-spacing: 0.04em;
  }

  .ch {
    font-size: var(--sz);
    fill: var(--fg);
    text-anchor: middle;
  }

  .ch--on {
    fill: var(--accent);
  }

  .lbl {
    font-size: var(--sz);
    fill: var(--fg);
  }
</style>
