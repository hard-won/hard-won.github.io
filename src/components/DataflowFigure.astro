    .dff-svg--narrow {
      display: block;
    }
  }

  /* --- ink ---------------------------------------------------------------- */

  .ln {
    fill: none;
    stroke: var(--rule);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* The links the traffic actually rides read at the same weight as the
     boxes they connect; hairlines at --rule are for rules and graduations. */
  .ln--net {
    stroke: var(--rule-strong);
  }

  .box {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .chev {
    fill: none;
    stroke: var(--rule-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  /* Tiles sit on the page, not on the links that pass beneath them, so the
     multicast wavefront hops from tile to tile. */
  .node {
    fill: var(--bg);
    stroke: var(--rule-strong);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hdr,
  .lbl {
    font-family: var(--font-mono);
    fill: var(--fg-muted);
