  /* --- motion -------------------------------------------------------------
     The step-length animations (operators, multicast, tiles, partial sums,
     the KV write, occupancy, the accumulator) repeat every 6s. The
     loop-length ones (KV reads, the gauge, the step counter) repeat every
     18s, because their story is the growth of the cache across three steps.
     The stripe sweep runs on 4.5s, which divides the master loop. */

  .flit,
  .mc,
  .tile-on,
  .op,
  .acc-on,
  .cell-on,
  .step,
  .burst {
    opacity: 0;
    animation-iteration-count: infinite;
  }

  .flit,
  .mc,
  .tile-on,
  .op,
  .acc-on,
  .occ {
    animation-duration: 6s;
    animation-timing-function: ease-in-out;
  }

  .cell-on,
  .step,
  .f-kvr {
    animation-duration: 18s;
    animation-timing-function: ease-in-out;
  }

  .burst {
    animation-duration: 4.5s;
    animation-timing-function: linear;
  }

  .occ {
    animation-name: dff-occ;
    animation-iteration-count: infinite;
  }

  .occ--t {
    animation-name: dff-tocc;
  }

  .burst {
    animation-name: dff-burst;
  }

  .mc {
    animation-name: dff-mc;
  }

  .tile-on {
