---
/**
 * The homepage figure: one transformer layer during one decode step, drawn
 * from the validated event ledger in `src/lib/decode-traffic/`.
 *
 * The rule this component exists to obey: **nothing here schedules
 * anything.** There are no keyframes, no transitions, no per-element
 * periods, no hand-written timings. Every visual state — which stage is
 * highlighted, where each parcel sits, whether compute is running or
 * waiting and on what, how many KV positions are valid — is
 * `sampleLayer()` / `sampleProjection()` from `src/lib/figure/frame.ts`
 * evaluated at one time value. The markup below is that sampler's output
 * at one chosen instant; `src/scripts/dataflow-figure.ts` re-evaluates the
 * same functions against the same ledger as the clock moves and writes the
 * results back onto these same elements.
 *
 * That is why the no-JS and reduced-motion states are correct rather than
 * blank: they are a real frame of the real model, chosen for what it
 * shows, and they are what this file emits.
 *
 * Two views, mutually exclusive when JS is on and stacked when it is not:
 *
 *   A. LAYER TRAFFIC      — the ledger's ten semantic stages and the
 *                           HBM/MC/BUF/COMPUTE lane its routes ride.
 *   B. PROJECTION MAPPING — one blocked y = W x, tile (r,c) owning
 *                           W[J_c, I_r], activations reused along a row,
 *                           partial sums reduced down a column.
 */
import { makeLayerLedger, makeProjectionLedger, STAGES } from '../lib/decode-traffic/index.ts';
import {
  annotateLayer,
  annotateProjection,
  LANE,
  NODE_NAME,
  lanePct,
  parcelLabel,
  sampleLayer,
  sampleProjection,
  projectionLayout,
  PROJECTION_WIDE,
  PROJECTION_NARROW,
} from '../lib/figure/frame.ts';
import type { ProjectionLayout, ProjectionSpec } from '../lib/figure/frame.ts';

/* The ledger, then its words. `annotate*` evaluates each event's display
   phrase once, here, so the payload the browser samples carries the model's
   own wording instead of a second copy of the code that produces it. */
const layer = annotateLayer(makeLayerLedger({ T0: 2048, stepIndex: 0 }));
const projection = annotateProjection(makeProjectionLedger(2, 3));

/**
 * The frames that ship in the HTML.
 *
 * View A at 5.700 s is the frame the rebuild exists to make possible: the
 * attention stage is highlighted, the keys it needs are still on the lane
 * between device memory and the buffers, and compute reads WAITING. The
 * figure this replaced drew the attention partial sums 1.3 s before that
 * same data arrived.
 *
 * View B at 3.600 s has one partial sum descending a column while two
 * other tiles are still computing their own products, which is the moment
 * that shows ownership, row reuse and column reduction at once.
 */
const T_STATIC_LAYER = 5700;
const T_STATIC_PROJECTION = 3600;

const frameA = sampleLayer(layer, T_STATIC_LAYER);
const wide: ProjectionLayout = projectionLayout(projection, PROJECTION_WIDE);
const narrow: ProjectionLayout = projectionLayout(projection, PROJECTION_NARROW);
const frameB = sampleProjection(projection, wide, T_STATIC_PROJECTION);

/** Every routed event gets one pre-rendered parcel; the clock reveals them. */
const layerParcels = layer.events.filter((e) => (e.route ?? []).length > 1);
const projParcels = projection.events.filter((e) => (e.route ?? []).length > 1);

/** Stage chips, in ledger order. The two residual adds name their own skip. */
const SKIP_TAG: Record<string, string> = {
  res1: '+ LAYER INPUT',
  res2: '+ POST-ATTN STATE',
};
const SHORT: Record<string, string> = {
  norm1: 'RMSNORM',
  qkv: 'Q/K/V PROJ',
  rope: 'ROPE (Q,K)',
  append: 'KV APPEND',
  attention: 'ATTENTION',
  o: 'O PROJ',
  norm2: 'RMSNORM',
  mlp: 'MLP',
  unshown: 'UNSHOWN WORK',
};
const stages = STAGES.map(([id], i) => ({
  id,
  n: String(i + 1).padStart(2, '0'),
  text: SKIP_TAG[id] ?? SHORT[id] ?? id.toUpperCase(),
  state: frameA.stage[id] ?? 'next',
}));

/* ---- View B geometry helpers. Lines first, boxes over them, parcels last. */

interface Box {
  x: number;
  y: number;
  w: number;
  h: number;
}
function tileBox(l: ProjectionLayout, id: string): Box {
  const a = l.anchor[id] as { x: number; y: number };
  return { x: a.x - l.spec.tw, y: a.y - l.spec.th, w: l.spec.tw * 2, h: l.spec.th * 2 };
}
function poly(l: ProjectionLayout, k: string): string {
  return (l.path[k] ?? []).map((p) => `${p.x},${p.y}`).join(' ');
}
const edgeKeys = projection.edges.map(([a, b]) => `${a}>${b}`);

/** Column centres and row centres, for the axis labels. */
const cols = Array.from({ length: projection.C }, (_, c) => c);
const rows = Array.from({ length: projection.R }, (_, r) => r);

const plates: { l: ProjectionLayout; spec: ProjectionSpec }[] = [
  { l: wide, spec: PROJECTION_WIDE },
  { l: narrow, spec: PROJECTION_NARROW },
];

/* ---- The payload the runtime samples. The scenes exactly as the model
       built them; the runtime rebuilds the layout with the same pure
       function this file used, so no geometry is duplicated either. ---- */
const payload = JSON.stringify({ layer, projection }).replace(/</g, '\\u003c');

const CAPTION_A =
  'ONE TRANSFORMER LAYER DURING ONE DECODE STEP, BATCH SIZE ONE, DRAWN FROM A VALIDATED EVENT LEDGER. ' +
  'EVENT ORDER ONLY: EQUAL-WIDTH STAGES ARE NOT EQUAL LATENCIES, AND NOTHING HERE IS A MEASUREMENT. ' +
  'THE SCHEDULE IS A CHOSEN SERIAL, CACHE-FIRST ILLUSTRATION — AN IMPLEMENTATION MAY PREFETCH, OVERLAP, FUSE, ' +
  'OR KEEP THE CURRENT K AND V ON CHIP INSTEAD OF WRITING THEM OUT AND READING THEM BACK. ' +
  'OPERAND DEMAND IS QUALITATIVE; NO ELEMENT HERE IS MEASURED HBM, NOC OR PE UTILIZATION.';

const CAPTION_B =
  'ONE BLOCK MATRIX–VECTOR PRODUCT y = W x, AS AN ILLUSTRATIVE MAPPING, NOT A GPU FLOORPLAN. ' +
  'TILE (r,c) OWNS W[J_c, I_r]; THE ROW ACTIVATION SLICE x[I_r] IS REUSED ALONG THE ROW; ' +
  'PARTIAL SUMS REDUCE DOWN THE COLUMN INTO THE OUTPUT SLICE y[J_c]. ' +
  'DEPENDENCY-VALID ORDER, NOT A CYCLE-ACCURATE NOC SIMULATION: NO ARBITRATION, BANDWIDTH OR CONTENTION IS MODELLED.';

/*
 * The two `aria-label`s describe the drawing's structure, never a moment in
 * it: with JavaScript the clock moves, and a label that named one instant
 * would be false at every other. The instant is carried by the readout
 * below each view, which is ordinary text outside the image role, so it is
 * read directly and updates with the frame.
 */
const LABEL_A =
  'Layer traffic. One transformer layer during one decode step at batch size one, drawn from an event ' +
  'ledger. Across the top, the ten semantic stages in order: RMSNorm, Q/K/V projections, RoPE on Q and K, ' +
  'KV append, attention, O projection, a residual add of the layer input, RMSNorm, MLP, and a residual add ' +
  'of the post-attention state, followed by a separator for the model work this view does not show. Below ' +
  'them, four endpoints in a line — device memory, the memory controller, local buffers and compute — and ' +
  'one lane between them, on which every parcel travels only between adjacent endpoints. Three states are ' +
  'drawn differently and mean different things: a highlighted stage is the phase being explained and may ' +
  'be waiting; a dashed marker on the compute band means the arithmetic is not running and the band names ' +
  'the operand it is short of; a filled band means the arithmetic is running with its operands in hand. A ' +
  'request parcel carries no payload and is drawn hollow; a read return and a KV write are drawn filled ' +
  'and differ in shape. The counter states how many KV positions are valid for this layer, counting up ' +
  'from a prefilled baseline of 2048 by one, at the moment the appended position becomes visible. ' +
  'Positions along the lane show order, not latency or propagation speed. The readout below states what ' +
  'is in flight at the current instant, where it came from, what it is for, and whether its consumer can ' +
  'compute.';

const LABEL_B =
  'Projection mapping. One block matrix-vector product y = W x on a two-row by three-column array of ' +
  'tiles. A weight buffer runs across the top and feeds one trunk per column. Tile (r,c) owns the weight ' +
  'block W[J_c, I_r] and no other tile consumes it, even when the block passes through one on its way ' +
  'down the column. Each row has its own source carrying the activation slice x[I_r], delivered to the ' +
  'first tile of the row and forwarded along it, so one slice is reused by every tile in that row. A tile ' +
  'forms its local product z[r,c] only once both its own weight block and its row activation have ' +
  'arrived, and an outlined tile means it is computing. Partial sums travel down their column and are ' +
  'added into the tile below. Each column ends in its own accumulator holding its own distinct output ' +
  'slice, y[J_0], y[J_1] and y[J_2]; the array never collapses to a single scalar. This is a dependency ' +
  'order, not a cycle-accurate network simulation. The readout below states what is on a link at the ' +
  'current instant and which rows each column has so far.';
---

<figure
  class="dfg"
  data-figure="dataflow"
  data-view="layer"
  data-t={T_STATIC_LAYER}
  data-t-projection={T_STATIC_PROJECTION}
>
  <div class="dfg__frame">
    <div class="dfg__bar">
      <div class="dfg__group" role="group" aria-label="Figure view">
        <span class="dfg__key" aria-hidden="true">VIEW</span>
        <button type="button" class="dfg__btn" data-view-btn="layer" aria-pressed="true">LAYER TRAFFIC</button>
        <button type="button" class="dfg__btn" data-view-btn="projection" aria-pressed="false">
          PROJECTION MAPPING
        </button>
      </div>
      <div class="dfg__group" role="group" aria-label="Playback">
        <button type="button" class="dfg__btn" data-act="toggle" aria-pressed="false">PAUSE</button>
        <button type="button" class="dfg__btn" data-act="step">STEP</button>
        <button type="button" class="dfg__btn" data-act="replay">REPLAY</button>
      </div>
    </div>

    <!-- =============================== VIEW A =============================== -->
    <section class="dfg__view" data-view="layer" aria-label="Layer traffic">
      <p class="dfg__title">ONE TRANSFORMER LAYER DURING ONE DECODE STEP · B = 1</p>
      <p class="dfg__sub">EVENT ORDER ONLY · NOT A LATENCY SCALE · SERIAL CACHE-FIRST DEPICTION</p>

      <ol class="dfg__stages" aria-label="Semantic stages in ledger order">
        {
          stages.map((s) => (
            <li class="dfg__stage" data-stage-id={s.id} data-state={s.state}>
              <span class="dfg__stage-n" aria-hidden="true">
                {s.n}
              </span>
              <span class="dfg__stage-t">{s.text}</span>
            </li>
          ))
        }
      </ol>
      <p class="dfg__foot">
        STAGE HIGHLIGHT MEANS "BEING EXPLAINED, POSSIBLY WAITING". COMPUTE-ACTIVE IS THE SEPARATE MARK ON THE
        COMPUTE BAND. Q/K/V AND MLP EXPAND INTO SEVERAL OPERATIONS; NORM SCALE VECTORS AND ON-CHIP ACTIVATION
        MOVEMENT ARE NOT DRAWN HERE.
      </p>

      <div class="dfg__bands" role="img" aria-label={LABEL_A}>
        <div class="dfg__rows">
          {
            LANE.map((id) => {
              const b = frameA.bands.find((x) => x.id === id);
              return (
                <div class="dfg__band" data-node-id={id} data-state={b?.state ?? 'idle'}>
                  <span class="dfg__band-name">{NODE_NAME[id]}</span>
                  <span class="dfg__band-text" data-band-text={id}>
                    {b?.text}
                  </span>
                </div>
              );
            })
          }
        </div>

        <div class="dfg__lane">
          <span class="dfg__lane-rule" aria-hidden="true"></span>
          {
            LANE.map((id) => (
              <span class="dfg__lane-stop" aria-hidden="true" style={`top:${lanePct(id)}%`} />
            ))
          }
          {
            layerParcels.map((e) => {
              const live = frameA.parcels.find((p) => p.id === e.id);
              return (
                <span
                  class="dfg__parcel"
                  data-event-id={e.id}
                  data-kind={e.kind}
                  data-tensor-id={e.tensor}
                  data-state={live ? 'on' : 'off'}
                  data-dir={live?.dir ?? 'down'}
                  style={`top:${(live?.pct ?? lanePct((e.route ?? [])[0] as string)).toFixed(3)}%`}
                >
                  <i class="dfg__mark" aria-hidden="true"></i>
                  <b class="dfg__tag">{parcelLabel(e)}</b>
                </span>
              );
            })
          }
        </div>
      </div>

      <p class="dfg__legend" aria-hidden="true">
        <span class="dfg__lk" data-kind="request">REQUEST (NO PAYLOAD)</span>
        <span class="dfg__lk" data-kind="read-return">READ RETURN</span>
        <span class="dfg__lk" data-kind="write-transfer">KV WRITE</span>
      </p>

      <p class="dfg__kv">
        <span class="dfg__key">VALID KV POSITIONS · THIS LAYER</span>
        <span class="dfg__kvval" data-kv-pending={String(frameA.kvPending)}>
          {frameA.kvBaseline} → <b data-kv>{frameA.kvValid}</b>
        </span>
        <span
          class="dfg__kvnote"
          data-kvnote
          data-base-note="PREFILLED BASELINE · NOT CAPACITY, NOT PAGES"
          data-replay-note="REPLAY NEXT · THE COUNT RETURNS TO THE 2048 PREFILLED BASELINE"
          >PREFILLED BASELINE · NOT CAPACITY, NOT PAGES</span
        >
      </p>

      <dl class="dfg__readout" data-readout="layer">
        {
          frameA.readout.map((r, i) => (
            <div class="dfg__row">
              <dt>{r.k}</dt>
              <dd data-readout-i={String(i)}>{r.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- =============================== VIEW B =============================== -->
    <section class="dfg__view" data-view="projection" aria-label="Projection mapping">
      <p class="dfg__title">ONE BLOCK MATRIX–VECTOR PRODUCT: y = W x</p>
      <p class="dfg__sub">ILLUSTRATIVE MAPPING · NOT A GPU FLOORPLAN · DEPENDENCY ORDER, NOT A NOC SIMULATION</p>

      {
        plates.map(({ l, spec }) => (
          <svg
            class:list={['dfg__svg', `dfg__svg--${spec.id}`]}
            viewBox={`0 0 ${spec.w} ${spec.h}`}
            role="img"
            aria-label={LABEL_B}
          >
            <title>{LABEL_B}</title>

            <g aria-hidden="true">
              {/* drawn links first, so boxes mask them */}
              {edgeKeys.map((k) => (
                <polyline class="dfg-ln dfg-ln--net" points={poly(l, k)} data-edge-id={k} />
              ))}

              {/* weight buffer */}
              <rect class="dfg-box" x="0" y={spec.wbufY - 11} width={spec.w} height="22" />
              <text class="dfg-t dfg-t--node" x="4" y={spec.wbufY + 3}>
                {spec.id === 'wide' ? 'WBUF · WEIGHT BLOCKS' : 'WBUF'}
              </text>

              {/* column trunk junctions */}
              {cols.map((c) => {
                const a = l.anchor[`WROOT${c}`] as { x: number; y: number };
                return <rect class="dfg-node" x={a.x - 3} y={a.y - 3} width="6" height="6" />;
              })}

              {/* row activation sources */}
              {rows.map((r) => {
                const a = l.anchor[`A${r}`] as { x: number; y: number };
                return (
                  <>
                    <rect class="dfg-box" x={spec.ax} y={a.y - 14} width={spec.aw} height="28" />
                    <text class="dfg-t dfg-t--node" x={spec.ax + 4} y={a.y + 3}>
                      {spec.id === 'wide' ? `A${r} · x[I${r}]` : `A${r}`}
                    </text>
                  </>
                );
              })}

              {/* tiles */}
              {rows.map((r) =>
                cols.map((c) => {
                  const id = `T${r}${c}`;
                  const b = tileBox(l, id);
                  const t = frameB.tiles.find((x) => x.id === id);
                  return (
                    <g
                      class="dfg-tile"
                      data-node-id={id}
                      data-w={String(t?.weightReady)}
                      data-a={String(t?.activationReady)}
                      data-z={String(t?.localReady)}
                      data-state={t?.computeActive ? 'active' : t?.localReady ? 'ready' : 'idle'}
                    >
                      <rect class="dfg-box dfg-box--tile" x={b.x} y={b.y} width={b.w} height={b.h} />
                      <text class="dfg-t dfg-t--node" x={b.x + 5} y={b.y + 14}>
                        {id}
                      </text>
                      <text class="dfg-t dfg-t--w" x={b.x + 5} y={b.y + 28}>
                        {t?.weight}
                      </text>
                      <text class="dfg-t dfg-t--a" x={b.x + 5} y={b.y + 41}>
                        {t?.activation}
                      </text>
                      <text class="dfg-t dfg-t--z" x={b.x + 5} y={b.y + 54}>
                        {t?.output}
                      </text>
                    </g>
                  );
                }),
              )}

              {/* accumulators, one output slice each */}
              {cols.map((c) => {
                const a = l.anchor[`ACC${c}`] as { x: number; y: number };
                const col = frameB.columns.find((x) => x.c === c);
                return (
                  <g class="dfg-acc" data-node-id={`ACC${c}`} data-state={col?.delivered ? 'ready' : 'idle'}>
                    <rect
                      class="dfg-box"
                      x={a.x - spec.tw}
                      y={a.y - 11}
                      width={spec.tw * 2}
                      height="22"
                    />
                    <text class="dfg-t dfg-t--node" x={a.x - spec.tw + 5} y={a.y + 3}>
                      {`y[J${c}]`}
                    </text>
                  </g>
                );
              })}

              {/* parcels last, on top */}
              {projParcels.map((e) => {
                const live = frameB.parcels.find((p) => p.id === e.id);
                const home = l.anchor[(e.route ?? [])[0] as string] as { x: number; y: number };
                const x = live?.x ?? home.x;
                const y = live?.y ?? home.y;
                return (
                  <g
                    class="dfg-parcel"
                    data-event-id={e.id}
                    data-kind={e.kind}
                    data-tensor-id={e.tensor}
                    data-state={live ? 'on' : 'off'}
                    transform={`translate(${x.toFixed(2)} ${y.toFixed(2)})`}
                  >
                    <rect class="dfg-flit" x="-4" y="-4" width="8" height="8" />
                  </g>
                );
              })}

              {spec.id === 'wide' && (
                <text class="dfg-t dfg-t--foot" x="0" y={spec.h - 6}>
                  ROW r CARRIES x[I_r] · COLUMN c REDUCES INTO y[J_c] · EVERY W BLOCK HAS EXACTLY ONE OWNER TILE
                </text>
              )}
              {spec.id === 'narrow' && (
                <>
                  <text class="dfg-t dfg-t--foot" x="0" y={spec.h - 19}>
                    A0 CARRIES x[I0] · A1 CARRIES x[I1]
                  </text>
                  <text class="dfg-t dfg-t--foot" x="0" y={spec.h - 6}>
                    ONE OWNER TILE PER W BLOCK
                  </text>
                </>
              )}
            </g>
          </svg>
        ))
      }

      <p class="dfg__legend" aria-hidden="true">
        <span class="dfg__lk" data-kind="weight-delivery">WEIGHT BLOCK</span>
        <span class="dfg__lk" data-kind="activation-delivery">ACTIVATION SLICE</span>
        <span class="dfg__lk" data-kind="partial-transfer">PARTIAL SUM</span>
        <span class="dfg__lk" data-kind="output-delivery">OUTPUT SLICE</span>
      </p>

      <dl class="dfg__readout" data-readout="projection">
        {
          frameB.readout.map((r, i) => (
            <div class="dfg__row">
              <dt>{r.k}</dt>
              <dd data-readout-i={String(i)}>{r.v}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <p class="dfg__sr" data-live aria-live="polite"></p>
  </div>

  <figcaption class="dfg__caption">
    <span data-caption="layer">{CAPTION_A}</span>
    <span data-caption="projection">{CAPTION_B}</span>
  </figcaption>

  <script type="application/json" data-dfg-scenes set:html={payload}></script>
</figure>

<script>
  import '../scripts/dataflow-figure.ts';
</script>

<style>
  /* -------------------------------------------------------------------------
     No @keyframes, no animation, no transition anywhere in this file. Motion
     is one clock writing sampled values onto these elements; a CSS duration
     here would be a second, independent period, which is exactly the defect
     this figure was rebuilt to remove.
  ------------------------------------------------------------------------- */

  .dfg {
    /* The "READ THE NOTE" link on the homepage follows immediately; the
       breathing room below the figure belongs to that line, not to this. */
    margin: 0 0 0.9rem;
    --sz: 0.625rem; /* 10px, the house floor for figure text */
    --pad: 0.5rem;
  }

  .dfg__frame {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.25rem 0 1.5rem;
  }

  .dfg__title,
  .dfg__sub,
  .dfg__foot,
  .dfg__key,
  .dfg__kvnote,
  .dfg__legend,
  .dfg__btn,
  .dfg__readout,
  .dfg__stage,
  .dfg__band,
  .dfg__tag {
    font-family: var(--font-mono);
    letter-spacing: 0.1em;
  }

  .dfg__title {
    font-size: 0.75rem;
    color: var(--fg);
    margin: 0;
  }

  .dfg__sub {
    font-size: var(--sz);
    color: var(--fg-faint);
    margin: 0.25rem 0 1rem;
    line-height: 1.6;
  }

  /* ---- controls: monospace text on a hairline, revealed only with JS ---- */

  .dfg__bar {
    display: none;
  }

  .dfg[data-js] .dfg__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
  }

  .dfg__group {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .dfg__btn {
    font-size: var(--sz);
    letter-spacing: 0.12em;
    font-family: inherit;
    color: var(--fg-muted);
    background: none;
    border: 0;
    border-bottom: 1px solid transparent;
    padding: 0.35rem 0;
    cursor: pointer;
  }

  .dfg__btn:hover {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .dfg__btn[aria-pressed='true'] {
    color: var(--fg);
    border-bottom-color: var(--accent);
  }

  .dfg__key {
    font-size: var(--sz);
    color: var(--fg-faint);
  }

  /* ---- views. Without JS both are shown, each at its own static frame. --- */

  .dfg__view + .dfg__view {
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.25rem;
  }

  .dfg[data-js] .dfg__view {
    display: none;
  }

  .dfg[data-js][data-view='layer'] .dfg__view[data-view='layer'],
  .dfg[data-js][data-view='projection'] .dfg__view[data-view='projection'] {
    display: block;
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }

  .dfg[data-js] .dfg__caption span {
    display: none;
  }

  .dfg[data-js][data-view='layer'] .dfg__caption span[data-caption='layer'],
  .dfg[data-js][data-view='projection'] .dfg__caption span[data-caption='projection'] {
    display: block;
  }

  /* ---- stage strip ---- */

  .dfg__stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8.5rem, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .dfg__stage {
