---
/**
 * FIG. 01 — ONE DECODE STEP, DRAWN AS TRAFFIC.
 *
 * ---------------------------------------------------------------------------
 * ACCELERATOR MODEL — the referent for the interconnect band
 * ---------------------------------------------------------------------------
 * This model is an ASSUMPTION of the depicted configuration, not a cited fact
 * about any shipping part. Nothing below is sourced; docs/figure-technical-notes.md
 * separates what is cited from what is assumed.
 *
 * Weight-stationary tiles in a 2D mesh. Memory controllers sit at one die edge
 * (drawn on the left, between the HBM channels and the array). Weights are
 * multicast from that edge: a trunk runs down the controller edge and a branch
 * runs along each row, so one fetch reaches every tile on the row rather than
 * being unicast tile by tile. Partial sums are forwarded tile to tile DOWN
 * each column and accumulated into an accumulator bank at the bottom edge of
 * the array. Batch of one, one layer, one decode step.
 *
 * The brief for this figure pinned "partial sums reduced along a row toward
 * the edge". Reduction is drawn down COLUMNS instead — the brief's own
 * correction allows "a row or a column", and putting distribution on rows and
 * reduction on columns makes the two directions perpendicular, so they are
 * never confusable. It is also the arrangement of a classic weight-stationary
 * systolic array, where operands stream across rows and partial sums descend
 * into the accumulator bank. See docs/figure-technical-notes.md.
 *
 * ---------------------------------------------------------------------------
 * WHAT EACH BAND SAYS
 * ---------------------------------------------------------------------------
 * 01 WORKLOAD     the real operator order of a pre-norm decoder layer, each
 *                 operator tagged with what it touches (RD W / WR KV / RD KV).
 * 02 HBM          every channel busy, every channel split into two
 *                 pseudo-channels, the served stripe sweeping CH0..CH3 in
 *                 phase-staggered order. The occupancy fill stays near full.
 *                 "Every channel busy" is what happens UNDER FINE-GRAINED
 *                 CROSS-CHANNEL INTERLEAVING, which is a memory-controller
 *                 policy and not a property of HBM — some controllers give
 *                 each pseudo-channel a contiguous region instead. The plate
 *                 says so, in the footnote beside the key.
 * 03 INTERCONNECT the multicast tree, the tiles it feeds, the reduction down
 *                 each column, and a TILES occupancy bar drawn in the same
 *                 grammar as the channel bars — and visibly far emptier.
 *
 * No number with a unit appears anywhere on the plate. The memory-bound claim
 * is made by the shape of the bars, not by a figure.
 *
 * ---------------------------------------------------------------------------
 * MECHANICS
 * ---------------------------------------------------------------------------
 * Pure SVG + CSS. No dependencies, no client JavaScript. One 18s master loop
 * of three 6s decode steps. Every event is scheduled purely with a negative
 * `animation-delay`, so the plate is mid-flight on first paint, and every
 * animated element is at the same state at 0% and 100% of its own cycle, so
 * the loop wraps without a seam.
 *
 * Two drawings are emitted and swapped by a media query: a four-channel,
 * 4x4 plate above 48rem and a four-channel, 4x3 stacked plate below it. A
 * viewBox cannot be reflowed from CSS, so the narrow plate is drawn rather
 * than squeezed. Both viewBoxes are sized so that at their smallest rendered
 * width one user unit is one CSS pixel — a 10px label is 10px on the glass.
 *
 * Only the global design tokens are borrowed (--fg, --fg-muted, --rule,
 * --rule-strong, --accent, --bg, --font-mono). No new hue is introduced;
 * the traffic classes differ by opacity, size, form and direction.
 */

/** Master loop, seconds: three decode steps of six. */
const LOOP = 18;
const STEP = 6;
const STEPS = LOOP / STEP;

/** Operator slot width. Eight slots of 0.7s leave a 0.4s gap before the next
 *  token's step — a token boundary, and headroom so the last burst of a step
 *  finishes inside it. Slot widths are uniform: this is an order, not a
 *  latency breakdown. */
const OP_DUR = 0.7;

/**
 * A Llama-style pre-norm decoder layer, in execution order. The tag is what
 * the operator touches off-chip: RD W reads weights, WR KV appends this
 * token's keys and values to the cache, RD KV reads the whole cache back.
 * KV READ is not a peer of QKV PROJ — it happens inside attention, which is
 * why only ATTN carries RD KV.
 */
const OPS: { name: string; tag: string }[] = [
  { name: 'RMSNORM', tag: '' },
  { name: 'QKV PROJ', tag: 'RD W' },
  { name: 'RoPE', tag: '' },
  { name: 'KV APPEND', tag: 'WR KV' },
  { name: 'ATTN', tag: 'RD KV' },
  { name: 'O PROJ', tag: 'RD W' },
  { name: 'RMSNORM', tag: '' },
  { name: 'MLP', tag: 'RD W' },
];

/* Operator slots 1 (QKV PROJ), 5 (O PROJ) and 7 (MLP) read weights; each
   fires a multicast burst. Those three are scheduled inside the `dff-mc`
   and `dff-tile` keyframes rather than per element, because the burst is
   identical every step. */
/** KV APPEND: the write that makes the gauge grow. */
const T_KVW = 3 * OP_DUR;
/** ATTN: cache reads, more of them every step. */
const T_KVR = 4 * OP_DUR;
/** Partial sums trail each wavefront, plus the attention reduction. */
const T_PS = [1.05, 3.05, 3.85, 5.15];
/** The stripe sweep runs on its own short cycle; 18 / 4.5 = 4, so it is
 *  still whole at the master wrap. */
const BURST = 4.5;

const CAPTION_1 =
  'FIG. 01 — ONE DECODE STEP OF A PRE-NORM DECODER LAYER, DRAWN AS TRAFFIC.';
const CAPTION_2 =
  'WEIGHTS MULTICAST FROM THE MEMORY EDGE, PARTIAL SUMS REDUCE DOWN EACH COLUMN. THE LINKS STAY BUSY WHILE THE TILES WAIT. SCHEMATIC, NOT TO SCALE.';

const LABEL =
  'One decode step of a pre-norm decoder layer, drawn as traffic. Three bands: ' +
  'the operator order — RMSNorm, QKV projection, RoPE, KV append, attention, ' +
  'output projection, RMSNorm, MLP — each tagged with what it reads or writes ' +
  'off-chip; four HBM channels, all busy, with the served stripe sweeping them ' +
  'in turn; and weights multicast from the memory edge into a mesh of tiles ' +
  'whose partial sums reduce into an accumulator bank. A segmented gauge grows ' +
  'with the KV cache at every step, and the tiles stay far idler than the links.';

type Pt = { x: number; y: number };
/** weight multicast · KV read · KV write · partial sum. */
type Kind = 'w' | 'kvr' | 'kvw' | 'ps';

interface Spec {
  id: 'wide' | 'narrow';
  w: number;
  h: number;
  /** Band headers. */
  hdr: { text: string; x: number; x2: number; y: number; ruleY: number }[];
  step: { x: number; y: number };
  /** Operator blocks: laid left to right on the wide plate, stacked on the
   *  narrow one. */
  op: {
    x: number;
    y: number;
    w: number;
    h: number;
    pitch: number;
    nameDy: number;
    tagDy: number;
    pad: number;
    stacked: boolean;
  };
  /** Channel rows. The array shares them, so an HBM link is a straight run. */
  rows: number[];
  bar: { x: number; w: number; h: number; labelX: number };
  note: { x: number; y: number; dy: number; lines: string[] };
  /** The interleave assumption, footnoted beside the key. */
  assume: { x: number; y: number; anchor: 'start' | 'end' };
  gauge: { x: number; y: number; w: number; h: number; cells: number; per: number; labelX: number };
  mc: { x: number; w: number; labelX: number; labelY: number };
  trunkX: number;
  cols: number[];
  tileW: number;
  tileH: number;
  acc: { x: number; y: number; w: number; h: number; labelX: number };
  tbar: { x: number; y: number; w: number; h: number; labelX: number };
  key: Pt[];
  /** Channel rows that take this step's KV write. */
  kvw: number[];
  /** KV reads per decode step — the cache is longer every step. */
  kvr: number[];
  burstW: number;
}

/* --- the two plates ------------------------------------------------------ */

const wide: Spec = {
  id: 'wide',
  w: 696,
  h: 314,
  hdr: [
    { text: '01 · WORKLOAD — ONE DECODE STEP', x: 0, x2: 696, y: 11, ruleY: 17 },
    { text: '02 · HBM', x: 0, x2: 250, y: 84, ruleY: 90 },
    { text: '03 · INTERCONNECT — WEIGHT-STATIONARY TILES', x: 268, x2: 696, y: 84, ruleY: 90 },
  ],
  step: { x: 696, y: 11 },
  op: { x: 0, y: 26, w: 79, h: 38, pitch: 87, nameDy: 16, tagDy: 30, pad: 8, stacked: false },
  rows: [124, 156, 188, 220],
  bar: { x: 38, w: 212, h: 24, labelX: 0 },
  note: { x: 38, y: 245, dy: 0, lines: ['2 PC / CH'] },
  assume: { x: 696, y: 300, anchor: 'end' },
  gauge: { x: 38, y: 254, w: 212, h: 24, cells: 18, per: 4, labelX: 0 },
  mc: { x: 280, w: 12, labelX: 280, labelY: 106 },
  trunkX: 308,
  cols: [342, 452, 562, 672],
  tileW: 28,
  tileH: 18,
  acc: { x: 328, y: 236, w: 358, h: 8, labelX: 284 },
  tbar: { x: 328, y: 254, w: 358, h: 24, labelX: 284 },
  key: [
    { x: 0, y: 300 },
    { x: 152, y: 300 },
    { x: 246, y: 300 },
    { x: 346, y: 300 },
  ],
  kvw: [1, 2],
  kvr: [2, 4, 6],
  burstW: 18,
};

const narrow: Spec = {
  id: 'narrow',
  w: 292,
  h: 448,
  hdr: [
    { text: '01 · WORKLOAD', x: 0, x2: 292, y: 11, ruleY: 17 },
    { text: '02 · HBM', x: 0, x2: 108, y: 202, ruleY: 208 },
    { text: '03 · INTERCONNECT', x: 118, x2: 292, y: 202, ruleY: 208 },
  ],
  step: { x: 292, y: 11 },
  op: { x: 0, y: 24, w: 292, h: 18, pitch: 20, nameDy: 12.5, tagDy: 12.5, pad: 8, stacked: true },
  rows: [234, 258, 282, 306],
  bar: { x: 26, w: 82, h: 20, labelX: 0 },
  note: { x: 0, y: 332, dy: 14, lines: ['2 PC / CH'] },
  assume: { x: 0, y: 436, anchor: 'start' },
  gauge: { x: 26, y: 364, w: 266, h: 20, cells: 18, per: 4, labelX: 0 },
  mc: { x: 118, w: 12, labelX: 118, labelY: 222 },
  trunkX: 140,
  cols: [168, 222, 276],
  tileW: 26,
  tileH: 16,
  acc: { x: 155, y: 322, w: 134, h: 6, labelX: 118 },
  tbar: { x: 155, y: 336, w: 134, h: 20, labelX: 118 },
  key: [
    { x: 0, y: 402 },
    { x: 150, y: 402 },
    { x: 0, y: 418 },
    { x: 150, y: 418 },
  ],
  kvw: [0, 3],
  kvr: [2, 4, 6],
  burstW: 14,
};

/* --- scheduling ---------------------------------------------------------- */

/**
 * Where in the master loop the page is when it first paints: the second
 * decode step, four seconds in, with O PROJ lit, the multicast tree across
 * the array, the wavefront still lighting tiles, partial sums descending, all
 * four channel stripes mid-sweep and the gauge two steps full. Nothing starts
 * empty, and nothing is mid-jump.
 */
const PHASE = 10;

/**
 * The only scheduling primitive. Places the 0% keyframe of an animation of
 * `period` at loop time `t0`, as a negative delay — so it is already running
 * on first paint.
 */
function dly(t0: number, period: number = LOOP): string {
  const d = ((((t0 - PHASE) % period) + period) % period) - period;
  return `${Number(d.toFixed(3))}s`;
}

/** A point as a CSS translate() argument list. */
function at(p: Pt): string {
  return `${Number(p.x.toFixed(2))}px, ${Number(p.y.toFixed(2))}px`;
}

function flitStyle(path: Pt[], delay: string, rest?: number): string {
  const vars = path.map((p, i) => `--p${i}:${at(p)}`).join(';');
  const rp = rest === undefined ? '' : `;--rp:var(--p${rest})`;
  return `${vars}${rp};animation-delay:${delay}`;
}

function build(s: Spec) {
  const nRows = s.rows.length;
  const nCols = s.cols.length;
  const hw = s.tileW / 2;
  const hh = s.tileH / 2;
  const mcMid = s.mc.x + s.mc.w / 2;
  const barMid = s.bar.x + s.bar.w * 0.5;
  const accMid = s.acc.y + s.acc.h / 2;
  const lane = s.bar.h / 4;
  const last = s.cols[nCols - 1];

  const ops = OPS.map((o, i) => ({
    ...o,
    x: s.op.stacked ? s.op.x : s.op.x + i * s.op.pitch,
    y: s.op.stacked ? s.op.y + i * s.op.pitch : s.op.y,
    delay: dly(i * OP_DUR, STEP),
    /* The frozen frame stops on O PROJ. */
    rm: i === 5,
  }));

  /* The multicast tree: one trunk down the controller edge, one branch along
     each row. The branches lie on the mesh links they use — the tiles are
     painted over them, so the wavefront hops from tile to tile. */
  const trunk = {
    d: `M ${s.mc.x + s.mc.w},${s.rows[0]} H ${s.trunkX} V ${s.rows[nRows - 1]}`,
    delay: dly(0, STEP),
    ro: 0,
  };
  const branches = s.rows.map((y, r) => ({
    d: `M ${s.trunkX},${y} H ${last}`,
    delay: dly(0.12 + r * 0.04, STEP),
    /* Frozen mid-flight: the near rows delivered, the far ones still drawing. */
    ro: [0, 12, 30, 55][r] ?? 55,
  }));

  const tiles: { x: number; y: number; delay: string; rm: boolean }[] = [];
  for (let r = 0; r < nRows; r += 1) {
    for (let c = 0; c < nCols; c += 1) {
      const off = r * 0.04 + c * 0.055;
      tiles.push({
        x: s.cols[c],
        y: s.rows[r],
        delay: dly(0.14 + off, STEP),
        /* The same wavefront, frozen: a tile is lit if the front has
           reached it. */
        rm: off <= 0.17,
      });
    }
  }

  /* KV reads: HBM -> controller edge -> along row -> across -> down to the
     tile holding that head. Routed on the mesh, never diagonally. Two at the
     first step, four at the second, six at the third: attention reads the
     whole cache, and the cache is one token longer every step. */
  const kvr: { style: string; rm: boolean }[] = [];
  for (let k = 0; k < STEPS; k += 1) {
    for (let m = 0; m < s.kvr[k]; m += 1) {
      const ch = (m + k) % nRows;
      const c = 1 + ((m + k) % (nCols - 1));
      const r = (ch + 1 + m) % nRows;
      const path: Pt[] = [
        { x: barMid, y: s.rows[ch] },
        { x: mcMid, y: s.rows[ch] },
        { x: s.cols[0], y: s.rows[ch] },
        { x: s.cols[c], y: s.rows[ch] },
        { x: s.cols[c], y: s.rows[r] },
      ];
      kvr.push({
        style: flitStyle(path, dly(k * STEP + T_KVR + m * 0.11, LOOP), 4),
        /* Two are parked at the tile they reached: the tail of this step's
           cache read, still landing as the next weight burst arrives. */
        rm: k === 1 && m < 2,
      });
    }
  }

  /* The KV write. Once per decode step, this token's K and V leave the tile
     that projected them, cross the controller edge and land in HBM — striped
     over two channels like everything else. It is why the gauge grows. */
  const kvw = s.kvw.map((rowIdx, i) => ({
    style: flitStyle(
      [
        { x: s.cols[0], y: s.rows[rowIdx] },
        { x: mcMid, y: s.rows[rowIdx] },
        { x: barMid, y: s.rows[rowIdx] },
      ],
      dly(T_KVW + i * 0.12, STEP),
      1,
    ),
  }));

  /* Partial sums: forwarded tile to tile down a column into the accumulator
     bank at the bottom edge. One descent trails each weight wavefront, plus
     one for the attention reduction. */
  const ps: { style: string; rm: boolean }[] = [];
  T_PS.forEach((t, wi) => {
    for (let c = 0; c < nCols; c += 1) {
      const path: Pt[] = s.rows
        .map((y) => ({ x: s.cols[c], y }))
        .concat([{ x: s.cols[c], y: accMid }]);
      ps.push({
        style: flitStyle(path, dly(t + c * 0.05, STEP), 2),
        rm: wi === 2,
      });
    }
  });

  /* Channel bars: an occupancy fill that never leaves the top of its range,
     and a stripe marker that sweeps the bar once in each pseudo-channel lane
     before wrapping. The four channels are offset by a third of a second, so
     the served stripe walks CH0 -> CH3 while every channel stays busy. */
  const chans = s.rows.map((y, i) => {
    const x0 = s.bar.x + 4;
    const x1 = s.bar.x + s.bar.w - 4 - s.burstW;
    return {
      i,
      y,
      occ: `animation-delay:${dly(i * 0.05, STEP)};--rs:0.93`,
      burst:
        `--a0:${at({ x: x0, y: y - lane })};--a1:${at({ x: x1, y: y - lane })};` +
        `--b0:${at({ x: x0, y: y + lane })};--b1:${at({ x: x1, y: y + lane })};` +
        `--rb:${at({ x: x0 + (x1 - x0) * (0.62 - i * 0.12), y: y - lane })};` +
        `animation-delay:${dly(i * 0.3, BURST)}`,
    };
  });

  /* The gauge: segmented, because a KV cache grows a page at a time. One
     group of cells per decode step, landing when the write lands. Six cells
     are never reached in this loop — the bar is an occupancy readout, not a
     capacity limit. */
  const pitch = (s.gauge.w - 6) / s.gauge.cells;
  const cells = Array.from({ length: s.gauge.cells }, (_, i) => {
    const group = Math.floor(i / s.gauge.per);
    return {
      x: s.gauge.x + 3 + i * pitch,
      w: pitch - 3,
      group: group < STEPS ? group : -1,
      /* A small stagger fills each group left to right. */
      style: `animation-delay:${dly((i % s.gauge.per) * 0.12, LOOP)}`,
      rm: group < 2,
    };
  });

  const steps = Array.from({ length: STEPS }, (_, k) => ({
    text: `STEP 0${k + 1}/0${STEPS}`,
    style: `animation-delay:${dly(k * STEP, LOOP)}`,
    rm: k === 1,
  }));

  return { ops, trunk, branches, tiles, kvr, kvw, ps, chans, cells, steps, hw, hh };
}

const plates = [wide, narrow].map((s) => ({ s, ...build(s) }));

const KEY: { kind: Kind; text: string }[] = [
  { kind: 'w', text: 'WEIGHT MULTICAST' },
  { kind: 'kvr', text: 'KV READ' },
  { kind: 'kvw', text: 'KV WRITE' },
  { kind: 'ps', text: 'PARTIAL SUM' },
];
---

<figure class="dff">
  <div class="dff__frame">
    {
      plates.map(({ s, ops, trunk, branches, tiles, kvr, kvw, ps, chans, cells, steps, hw, hh }) => (
        <svg
          class:list={['dff-svg', `dff-svg--${s.id}`]}
          viewBox={`0 0 ${s.w} ${s.h}`}
          role="img"
          aria-label={LABEL}
        >
          <title>{LABEL}</title>

          {/* band headers — read these first */}
          <g aria-hidden="true">
            {s.hdr.map((b) => (
              <>
                <text class="hdr" x={b.x} y={b.y}>
                  {b.text}
                </text>
                <line class="ln" x1={b.x} y1={b.ruleY} x2={b.x2} y2={b.ruleY} />
              </>
            ))}
            {steps.map((k) => (
              <text
                class:list={['lbl', 'step', k.rm && 'step--rm']}
                x={s.step.x}
                y={s.step.y}
                text-anchor="end"
                style={k.style}
              >
                {k.text}
              </text>
            ))}
          </g>

          {/* band 01 — the operator order, left to right (stacked when narrow) */}
          <g aria-hidden="true">
            {ops.map((o, i) => (
              <>
                <rect class="box" x={o.x} y={o.y} width={s.op.w} height={s.op.h} />
                <text class="lbl lbl--op" x={o.x + s.op.pad} y={o.y + s.op.nameDy}>
                  {o.name}
                </text>
                {o.tag && (
                  <text
                    class="lbl lbl--tag"
                    x={s.op.stacked ? o.x + s.op.w - s.op.pad : o.x + s.op.w - s.op.pad}
                    y={o.y + s.op.tagDy}
                    text-anchor="end"
                  >
                    {o.tag}
                  </text>
                )}
                <g
                  class:list={['op', o.rm && 'op--rm']}
                  style={`animation-delay:${o.delay}`}
                >
                  <rect class="tint" x={o.x} y={o.y} width={s.op.w} height={s.op.h} />
                  <rect class="edge" x={o.x} y={o.y} width="2.5" height={s.op.h} />
                  <text class="lbl lbl--on" x={o.x + s.op.pad} y={o.y + s.op.nameDy}>
                    {o.name}
                  </text>
                </g>
                {!s.op.stacked && i < OPS.length - 1 && (
                  <path
                    class="chev"
                    d={`M ${o.x + s.op.w + 3},${o.y + s.op.h / 2 - 4} L ${o.x + s.op.w + 7},${o.y + s.op.h / 2} L ${o.x + s.op.w + 3},${o.y + s.op.h / 2 + 4}`}
                  />
                )}
              </>
            ))}
          </g>

          {/* band 02 — HBM channels, and the KV-cache gauge */}
          <g aria-hidden="true">
            {chans.map((c) => (
              <>
                <text class="lbl" x={s.bar.labelX} y={c.y + 3.5}>
                  {`CH${c.i}`}
                </text>
                <rect
                  class="occ"
                  x={s.bar.x}
                  y={c.y - s.bar.h / 2}
                  width={s.bar.w}
                  height={s.bar.h}
                  style={c.occ}
                />
                {/* the pseudo-channel split: two 32-bit halves of one channel */}
                <line class="ln" x1={s.bar.x} y1={c.y} x2={s.bar.x + s.bar.w} y2={c.y} />
                <rect
                  class="box"
                  x={s.bar.x}
                  y={c.y - s.bar.h / 2}
                  width={s.bar.w}
                  height={s.bar.h}
                />
                <g class="burst" style={c.burst}>
                  <rect
                    x="0"
                    y={-(s.bar.h / 4 - 1)}
                    width={s.burstW}
                    height={s.bar.h / 2 - 2}
                  />
                </g>
                {/* channel to its controller */}
                <line
                  class="ln ln--net"
                  x1={s.bar.x + s.bar.w}
                  y1={c.y}
                  x2={s.mc.x}
                  y2={c.y}
                />
              </>
            ))}

            {s.note.lines.map((line, i) => (
              <text class="lbl lbl--note" x={s.note.x} y={s.note.y + i * s.note.dy}>
                {line}
              </text>
            ))}

            <text class="lbl" x={s.gauge.labelX} y={s.gauge.y + s.gauge.h / 2 + 3.5}>
              KV$
            </text>
            <rect
              class="box"
              x={s.gauge.x}
              y={s.gauge.y}
              width={s.gauge.w}
              height={s.gauge.h}
            />
            {cells.map((c) => (
              <>
                <rect
                  class="cell"
                  x={c.x}
                  y={s.gauge.y + 4}
                  width={c.w}
                  height={s.gauge.h - 8}
                />
                {c.group >= 0 && (
                  <rect
                    class:list={['cell-on', `cell-on--${c.group}`, c.rm && 'cell-on--rm']}
                    x={c.x}
                    y={s.gauge.y + 4}
                    width={c.w}
                    height={s.gauge.h - 8}
                    style={c.style}
                  />
                )}
              </>
            ))}
          </g>

          {/* band 03 — controller edge, multicast tree, tiles, reduction */}
          <g aria-hidden="true">
            <text class="lbl" x={s.mc.labelX} y={s.mc.labelY}>
              MC
            </text>
            {s.rows.map((y) => (
              <rect
                class="box"
                x={s.mc.x}
                y={y - s.tileH / 2}
                width={s.mc.w}
                height={s.tileH}
              />
            ))}

            {/* mesh links: the distribution bus and the tile-to-tile links */}
            <line class="ln ln--net" x1={s.mc.x + s.mc.w} y1={s.rows[0]} x2={s.trunkX} y2={s.rows[0]} />
            <line
              class="ln ln--net"
              x1={s.trunkX}
              y1={s.rows[0]}
              x2={s.trunkX}
              y2={s.rows[s.rows.length - 1]}
            />
            {s.rows.map((y) => (
              <line class="ln ln--net" x1={s.trunkX} y1={y} x2={s.cols[0] - hw} y2={y} />
            ))}
            {s.rows.map((y) =>
              s.cols.slice(1).map((x, i) => (
                <line class="ln ln--net" x1={s.cols[i] + hw} y1={y} x2={x - hw} y2={y} />
              )),
            )}
            {s.cols.map((x) =>
              s.rows.slice(1).map((y, i) => (
                <line class="ln ln--net" x1={x} y1={s.rows[i] + hh} x2={x} y2={y - hh} />
              )),
            )}
            {s.cols.map((x) => (
              <line
                class="ln ln--net"
                x1={x}
                y1={s.rows[s.rows.length - 1] + hh}
                x2={x}
                y2={s.acc.y}
              />
            ))}

            {/* the multicast tree, drawn root first and then branch by branch */}
            <path class="mc mc--trunk" d={trunk.d} pathLength="100" style={`animation-delay:${trunk.delay};--ro:${trunk.ro}`} />
            {branches.map((b) => (
              <path class="mc mc--rm" d={b.d} pathLength="100" style={`animation-delay:${b.delay};--ro:${b.ro}`} />
            ))}

            {/* tiles: a router with an input queue on its left, and a PE */}
            {tiles.map((t) => (
              <>
                <rect
                  class="node"
                  x={t.x - hw}
                  y={t.y - hh}
                  width={s.tileW}
                  height={s.tileH}
                />
                <line class="ln" x1={t.x - hw + 7} y1={t.y - hh} x2={t.x - hw + 7} y2={t.y + hh} />
                <line class="ln" x1={t.x - hw} y1={t.y} x2={t.x - hw + 7} y2={t.y} />
                <g class:list={['tile-on', t.rm && 'tile-on--rm']} style={`animation-delay:${t.delay}`}>
                  <rect
                    class="edge"
                    x={t.x - hw + 1}
                    y={t.y - hh + 1}
                    width="5"
                    height={s.tileH / 2 - 1.5}
                  />
                  <rect
                    class="tint"
                    x={t.x - hw + 7}
                    y={t.y - hh}
                    width={s.tileW - 7}
                    height={s.tileH}
                  />
                </g>
              </>
            ))}

            {/* accumulator bank at the bottom edge of the array */}
            <text class="lbl" x={s.acc.labelX} y={s.acc.y + s.acc.h / 2 + 3.5}>
              ACC
            </text>
            <rect class="acc-on" x={s.acc.x} y={s.acc.y} width={s.acc.w} height={s.acc.h} style={`animation-delay:${dly(0, STEP)}`} />
            <rect class="box" x={s.acc.x} y={s.acc.y} width={s.acc.w} height={s.acc.h} />

            {/* tile occupancy, in the same grammar as a channel bar */}
            <text class="lbl" x={s.tbar.labelX} y={s.tbar.y + s.tbar.h / 2 + 3.5}>
              TILES
            </text>
            <rect
              class="occ occ--t"
              x={s.tbar.x}
              y={s.tbar.y}
              width={s.tbar.w}
              height={s.tbar.h}
              style={`animation-delay:${dly(0, STEP)};--rs:0.14`}
            />
            <rect class="box" x={s.tbar.x} y={s.tbar.y} width={s.tbar.w} height={s.tbar.h} />
          </g>

          {/* traffic */}
          <g aria-hidden="true">
            {ps.map((f) => (
              <g class:list={['flit', 'flit--p5', 'f-ps', f.rm && 'flit--rm']} style={f.style}>
                <rect x="-3.5" y="-2" width="7" height="4" />
              </g>
            ))}
            {kvr.map((f) => (
              <g class:list={['flit', 'flit--k5', 'f-kvr', f.rm && 'flit--rm']} style={f.style}>
                <rect x="-5" y="-2.5" width="10" height="5" />
              </g>
            ))}
            {kvw.map((f) => (
              <g class="flit flit--w3 f-kvw" style={f.style}>
                <rect x="-5" y="-2.5" width="10" height="5" />
              </g>
            ))}
          </g>

          {/* key */}
          <g aria-hidden="true">
            {KEY.map((k, i) => (
              <>
                {k.kind === 'w' ? (
                  <path
                    class="sw-mc"
                    d={`M ${s.key[i].x},${s.key[i].y - 3.5} h 5 M ${s.key[i].x + 5},${s.key[i].y - 7} v 7 M ${s.key[i].x + 5},${s.key[i].y - 7} h 6 M ${s.key[i].x + 5},${s.key[i].y} h 6`}
                  />
                ) : (
                  <rect
                    class:list={['sw', `f-${k.kind}`]}
                    x={s.key[i].x}
                    y={s.key[i].y - 6}
                    width={k.kind === 'ps' ? 8 : 11}
                    height={k.kind === 'ps' ? 4 : 5}
                  />
                )}
                <text class="lbl" x={s.key[i].x + 18} y={s.key[i].y}>
                  {k.text}
                </text>
              </>
            ))}
            {/* The stripe sweep is only what a fine-grained cross-channel
                interleave looks like. That is a controller policy, so the
                plate says it is assumed rather than implying it is a law. */}
            <text
              class="lbl lbl--note"
              x={s.assume.x}
              y={s.assume.y}
              text-anchor={s.assume.anchor}
            >
              ASSUMES FINE-GRAIN CHANNEL INTERLEAVE
            </text>
          </g>
        </svg>
      ))
    }
  </div>
  <figcaption class="dff__caption">
    <span>{CAPTION_1}</span>
    <span>{CAPTION_2}</span>
  </figcaption>
</figure>

<style>
  .dff {
    margin: 0 0 4.5rem;
  }

  .dff__frame {
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 1.5rem 0;
