  }

  .dff__caption span + span {
    color: var(--fg-faint);
  }

  /* Both viewBoxes are sized to their narrowest container, so one user unit
     is one CSS pixel there and a 10px label is 10px on the glass. The wide
     plate is 696 because the page shell is 46rem less 1.25rem of padding a
     side; the narrow one is 292 because the shell is 320 less 0.875rem a
     side at the smallest supported width. */
  .dff-svg {
    display: block;
    width: 100%;
    height: auto;
    --lbl: 10px;
    --hdr: 10px;
  }

  .dff-svg--narrow {
    display: none;
    max-width: 28rem;
  }

  @media (max-width: 48rem) {
    .dff-svg--wide {
      display: none;
