---
/**
 * The chain this work is organised around. Hand-built from HTML + CSS + one
 * inline SVG arrow, so it is real text (selectable, translatable, readable by
 * screen readers) and inherits the theme's colours in both light and dark.
 *
 * Wide viewports lay it out as a row; below 48rem it stacks and the arrows
 * rotate a quarter turn.
 */
const stages = [
  { label: 'AI Workload', sub: 'models, shapes, phases' },
  { label: 'Data Movement', sub: 'reuse, traffic, locality' },
  { label: 'Memory Systems', sub: 'bandwidth, latency, HBM' },
  { label: 'Interconnect / NoC', sub: 'topology, routing, flow control' },
  { label: 'RTL', sub: 'datapath, timing, verification' },
];
---

<figure class="pipeline-figure">
  <ol class="pipeline-flow" aria-label="From AI workload to RTL">
    {
      stages.map((stage, i) => (
        <li class="pipeline-stage">
          <div class="pipeline-box">
            <span class="pipeline-label">{stage.label}</span>
            <span class="pipeline-sub">{stage.sub}</span>
          </div>
          {i < stages.length - 1 && (
            <svg class="pipeline-arrow" viewBox="0 0 24 12" aria-hidden="true" focusable="false">
              <path d="M1 6h19" />
              <path d="M16 2l5 4-5 4" />
            </svg>
          )}
        </li>
      ))
    }
  </ol>
  <figcaption>
    Each stage constrains the next. The interesting questions live in the arrows.
  </figcaption>
</figure>

<style>
  .pipeline-figure {
    margin: 1.75rem 0 0;
    max-width: 100%;
  }

  .pipeline-flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .pipeline-stage {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    flex: 1 1 0;
    min-width: 0;
  }

  .pipeline-box {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 0.6rem 0.75rem;
    height: 100%;
  }

  .pipeline-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.3;
    /* Body sets overflow-wrap: break-word; without this, "Interconnect"
       breaks mid-word in the narrow row layout. */
    overflow-wrap: normal;
    hyphens: none;
  }

  .pipeline-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.45;
    color: var(--fg-faint);
  }

  .pipeline-arrow {
    display: block;
    width: 1.5rem;
    height: 0.75rem;
    margin: 0.4rem auto;
    transform: rotate(90deg);
    stroke: var(--accent);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    flex: none;
  }

  .pipeline-figure figcaption {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--fg-faint);
    max-width: var(--measure);
  }

  @media (min-width: 48rem) {
    .pipeline-flow {
      flex-direction: row;
      align-items: stretch;
    }

    .pipeline-stage {
      flex-direction: row;
      align-items: center;
      /* Size to content so the longest label ("Interconnect / NoC") gets the
         room it needs instead of being squeezed into an equal fifth. */
      flex: 1 1 auto;
    }

    .pipeline-stage .pipeline-box {
      flex: 1 1 auto;
      min-width: 0;
    }

    .pipeline-label {
      font-size: 0.8125rem;
    }

    .pipeline-arrow {
      transform: none;
      margin: 0 0.3rem;
      width: 1.25rem;
    }
  }
</style>
